--style full:bold
--layout reverse
--reverse
--margin 0,0,0,0
--padding 0,0
--border none
--border-label ''
--border-label-pos center:top
--prompt '> '
--pointer '┃'
--marker '┃'
--ellipsis '…'
--info inline-right
--info-command 'echo -n " {+n}/{n}  " | sed "s/^ //"'
--scrollbar '█'
--gap 0
--gap-line '┈'
--gutter '▌'
--cycle
--wrap
--wrap-sign '↪ '
--jump-labels 'qwertyuiopasdfghjklzxcvbnm'
--tabstop 2
--highlight-line
--header-border bold
--header-label ''
--header-label-pos 4:top
--preview 'bat --tabs=2 --wrap=character --color=always --decorations=never --paging=never --strip-ansi=always --style=changes {} 2>/dev/null || eza --width=1 --across --almost-all --classify=always --color=always --grid --group-directories-first --icons=always --level=1 --sort=Name {} 2>/dev/null || print {}'
--preview-window 'right:50%:border-bold'
--preview-border bold
--preview-label ''
--preview-label-pos center:top
--bind 'Ctrl-Left:change-preview-window(left:50%)'
--bind 'Ctrl-Down:change-preview-window(down:50%)'
--bind 'Ctrl-Up:change-preview-window(up:50%)'
--bind 'Ctrl-Right:change-preview-window(right:50%)'
--bind '?:toggle-preview'
--bind '\:toggle-wrap'
--multi
--tiebreak begin,chunk,length,index
--smart-case
--extended
--scheme default
